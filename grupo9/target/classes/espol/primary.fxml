<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="12.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="espol.controller.JuegoController">

    <padding>
        <Insets top="20.0"
                bottom="20.0"
                left="20.0"
                right="20.0"/>
    </padding>

    <!-- ================================================= -->
    <!-- TÍTULO -->
    <!-- ================================================= -->

    <Label text="Tres en Raya"
           style="-fx-font-size: 26px;
                  -fx-font-weight: bold;"/>

    <!-- ================================================= -->
    <!-- MODO DE JUEGO -->
    <!-- ================================================= -->

    <Label text="Modo de juego:"
           style="-fx-font-size: 15px;
                  -fx-font-weight: bold;"/>

    <HBox alignment="CENTER"
          spacing="20.0">

        <RadioButton
                fx:id="rbHumanoVsComputadora"
                text="Humano vs Computadora"/>

        <RadioButton
                fx:id="rbComputadoraVsComputadora"
                text="Computadora vs Computadora"/>

    </HBox>

    <!-- ================================================= -->
    <!-- SÍMBOLO HUMANO -->
    <!-- ================================================= -->

    <Label text="Selecciona tu símbolo:"
           style="-fx-font-size: 15px;"/>

    <HBox alignment="CENTER"
          spacing="20.0">

        <RadioButton
                fx:id="rbHumanoX"
                text="X"/>

        <RadioButton
                fx:id="rbHumanoO"
                text="O"/>

    </HBox>

    <!-- ================================================= -->
    <!-- QUIÉN COMIENZA -->
    <!-- ================================================= -->

    <Label text="¿Quién comienza?"
           style="-fx-font-size: 15px;"/>

    <HBox alignment="CENTER"
          spacing="20.0">

        <RadioButton
                fx:id="rbIniciaHumano"
                text="Humano"/>

        <RadioButton
                fx:id="rbIniciaComputadora"
                text="Computadora"/>

    </HBox>

    <!-- ================================================= -->
    <!-- COMENZAR -->
    <!-- ================================================= -->

    <Button
            fx:id="btnComenzar"
            text="Comenzar partida"
            onAction="#comenzarJuego"/>

    <!-- ================================================= -->
    <!-- ESTADO -->
    <!-- ================================================= -->

    <Label
            fx:id="lblEstado"
            text="Selecciona la configuración"
            style="-fx-font-size: 18px;
                   -fx-font-weight: bold;"/>
    
    <Label
            fx:id="lblvictoriasHumano"
            text="VictoriasHumano"          
            style="-fx-font-size: 18px;
                   -fx-font-weight: bold;"/>
    
    <Label
            fx:id="lblvictoriasComputadora"
            text="VictoriasCPU"
            style="-fx-font-size: 18px;
                   -fx-font-weight: bold;"/>

    <!-- ================================================= -->
    <!-- TABLERO -->
    <!-- ================================================= -->

    <GridPane alignment="CENTER"
              hgap="5.0"
              vgap="5.0">

        <!-- FILA 0 -->

        <Button fx:id="btn00"
                text=""
                prefWidth="80.0"
                prefHeight="80.0"
                style="-fx-font-size: 24px;"
                onAction="#jugar00"
                GridPane.rowIndex="0"
                GridPane.columnIndex="0"/>

        <Button fx:id="btn01"
                text=""
                prefWidth="80.0"
                prefHeight="80.0"
                style="-fx-font-size: 24px;"
                onAction="#jugar01"
                GridPane.rowIndex="0"
                GridPane.columnIndex="1"/>

        <Button fx:id="btn02"
                text=""
                prefWidth="80.0"
                prefHeight="80.0"
                style="-fx-font-size: 24px;"
                onAction="#jugar02"
                GridPane.rowIndex="0"
                GridPane.columnIndex="2"/>

        <!-- FILA 1 -->

        <Button fx:id="btn10"
                text=""
                prefWidth="80.0"
                prefHeight="80.0"
                style="-fx-font-size: 24px;"
                onAction="#jugar10"
                GridPane.rowIndex="1"
                GridPane.columnIndex="0"/>

        <Button fx:id="btn11"
                text=""
                prefWidth="80.0"
                prefHeight="80.0"
                style="-fx-font-size: 24px;"
                onAction="#jugar11"
                GridPane.rowIndex="1"
                GridPane.columnIndex="1"/>

        <Button fx:id="btn12"
                text=""
                prefWidth="80.0"
                prefHeight="80.0"
                style="-fx-font-size: 24px;"
                onAction="#jugar12"
                GridPane.rowIndex="1"
                GridPane.columnIndex="2"/>

        <!-- FILA 2 -->

        <Button fx:id="btn20"
                text=""
                prefWidth="80.0"
                prefHeight="80.0"
                style="-fx-font-size: 24px;"
                onAction="#jugar20"
                GridPane.rowIndex="2"
                GridPane.columnIndex="0"/>

        <Button fx:id="btn21"
                text=""
                prefWidth="80.0"
                prefHeight="80.0"
                style="-fx-font-size: 24px;"
                onAction="#jugar21"
                GridPane.rowIndex="2"
                GridPane.columnIndex="1"/>

        <Button fx:id="btn22"
                text=""
                prefWidth="80.0"
                prefHeight="80.0"
                style="-fx-font-size: 24px;"
                onAction="#jugar22"
                GridPane.rowIndex="2"
                GridPane.columnIndex="2"/>

    </GridPane>

    <!-- ================================================= -->
    <!-- REINICIAR -->
    <!-- ================================================= -->

    <Button
            fx:id="btnReiniciar"
            text="Reiniciar partida"
            onAction="#reiniciarJuego"/>

</VBox>